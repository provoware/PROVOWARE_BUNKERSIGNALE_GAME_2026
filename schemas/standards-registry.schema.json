{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sound-system-iker.local/schema/standards-registry/1.0.0",
  "type": "object",
  "required": [
    "verified_on",
    "standards"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "verified_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "standards": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "scope",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
