{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sound-system-iker.local/schema/change-record/1.0.0",
  "type": "object",
  "required": [
    "change_id",
    "checkpoint",
    "title",
    "purpose",
    "scope",
    "non_goals",
    "affected_owners",
    "compatibility",
    "security",
    "test_plan",
    "rollback",
    "evidence",
    "result"
  ],
  "properties": {
    "change_id": {
      "const": "CHG-20260918-001"
    },
    "checkpoint": {
      "const": "I00"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "affected_owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "compatibility": {
      "type": "string",
      "minLength": 1
    },
    "security": {
      "type": "string",
      "minLength": 1
    },
    "test_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "result": {
      "enum": [
        "GREEN",
        "RED"
      ]
    }
  },
  "additionalProperties": false
}
