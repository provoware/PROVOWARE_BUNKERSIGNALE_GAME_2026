{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sound-system-iker.local/schema/repository-layout/1.0.0",
  "type": "object",
  "required": [
    "version",
    "areas"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": "1.0.0"
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "owner",
          "first_write_checkpoint",
          "purpose"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
