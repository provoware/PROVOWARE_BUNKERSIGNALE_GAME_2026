{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sound-system-iker.local/schema/event-envelope/1.0.0",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "payload",
    "author_id",
    "sequence",
    "lamport",
    "ruleset_version",
    "metadata"
  ],
  "properties": {
    "event_id": {"type":"string","pattern":"^event:[0-9a-f]{24}$"},
    "event_type": {"type":"string","pattern":"^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "payload": {"type":"object"},
    "author_id": {"type":"string","pattern":"^actor:[0-9a-f]{24}$"},
    "sequence": {"type":"integer"},
    "lamport": {"type":"integer"},
    "ruleset_version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "metadata": {"type":"object"},
    "command_id": {"type":"string","minLength":1},
    "correlation_id": {"type":"string","minLength":1},
    "causation_event_id": {"type":"string","pattern":"^event:[0-9a-f]{24}$"}
  },
  "additionalProperties": false
}
