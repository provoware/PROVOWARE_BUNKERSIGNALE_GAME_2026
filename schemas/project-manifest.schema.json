{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sound-system-iker.local/schema/project-manifest/1.0.0",
  "title": "S.O.U.N.D. SYSTEM-IKER Project Manifest",
  "type": "object",
  "required": [
    "project_id",
    "title",
    "product_version",
    "specification_baseline",
    "checkpoint",
    "status",
    "runtime_strategy",
    "tooling_python_min",
    "license_state",
    "canonical_encoding",
    "canonical_line_endings",
    "next_checkpoint",
    "normative_documents"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project_id": {
      "const": "sound-system-iker"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "product_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "specification_baseline": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "checkpoint": {
      "type": "string",
      "pattern": "^I[0-9]{2}$"
    },
    "checkpoint_title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "runtime_strategy": {
      "const": "browser_local_first"
    },
    "tooling_python_min": {
      "const": "3.12"
    },
    "license_state": {
      "const": "UNLICENSED"
    },
    "canonical_encoding": {
      "const": "UTF-8"
    },
    "canonical_line_endings": {
      "const": "LF"
    },
    "next_checkpoint": {
      "type": "string",
      "pattern": "^I[0-9]{2}$"
    },
    "normative_documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
