{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sound-system-iker.local/schema/content-registry/1.0.0",
  "type": "object",
  "required": ["version", "resolution", "packages"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": "1.0.0"},
    "resolution": {"const": "exact_version_only"},
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package_id", "version", "path", "dependencies"],
        "properties": {
          "package_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "path": {"type": "string", "minLength": 1},
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["package_id", "version"],
              "properties": {
                "package_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
                "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
