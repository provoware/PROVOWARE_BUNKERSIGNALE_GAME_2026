{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sound-system-iker.local/schema/schema-registry/1.0.0",
  "type": "object",
  "required": ["version", "resolution", "lifecycle", "entries"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": "1.0.0"},
    "resolution": {"const": "exact_version_only"},
    "lifecycle": {
      "type": "object",
      "required": ["states", "transitions"],
      "properties": {
        "states": {
          "type": "array",
          "const": ["active", "deprecated", "retired"]
        },
        "transitions": {
          "type": "array",
          "const": ["active->deprecated", "deprecated->retired"]
        }
      },
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "schema_id", "path", "status", "introduced_in"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "schema_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^schemas/[a-z0-9-]+\\.schema\\.json$"},
          "status": {"enum": ["active", "deprecated", "retired"]},
          "introduced_in": {"type": "string", "pattern": "^I[0-9]{2}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
